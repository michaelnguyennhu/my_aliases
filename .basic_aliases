#################
# Text Editors
######################
function te() { gnome-text-editor "$1" & }

#################
# Alias stuff
######################
alias addalias="te ~/.basic_aliases ~/.aliases ~/.bashrc &"
alias srcbash="source ~/.bashrc"

#################
# Basics
######################
alias ls="ls --color=auto -l"
alias lsa="ls -la"
alias ll="ls -lrt"
alias lla="ls -lart" 

alias b="cd .." 
alias rmrf="rm -rf" 

